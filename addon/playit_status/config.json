{
  "name": "Playit DC Status Add-on",
  "version": "0.1.0",
  "slug": "playit_status",
  "description": "Lightweight Supervisor add-on that polls Playit status and logs results (skeleton).",
  "arch": ["amd64", "armv7", "armhf", "aarch64", "i386"],
  "startup": "services",
  "boot": "auto",
  "host_network": false,
  "homeassistant": ["core>=2021.12.0"],
  "map": ["config:rw"],
  "options": {
    "status_url": "https://dc.status.playit.gg/",
    "interval": 60
  },
  "schema": {
    "status_url": "str",
    "interval": "int"
  }
}
